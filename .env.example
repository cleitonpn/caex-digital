# O modo demo funciona sem Firebase e guarda alterações no navegador.
VITE_DATA_MODE=demo

# Preencha apenas quando um projeto Firebase real for criado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Em desenvolvimento, conecta o SDK aos emuladores locais.
VITE_USE_FIREBASE_EMULATORS=true
