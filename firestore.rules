rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }
    function belongsToTenant(tenantId) {
      return signedIn() && membership(tenantId).data.active == true;
    }
    function isTenantAdmin(tenantId) {
      return belongsToTenant(tenantId) &&
        membership(tenantId).data.role in ['platform_admin', 'organizer_admin', 'event_manager'];
    }

    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      allow write: if isTenantAdmin(tenantId);

      match /members/{memberId} {
        allow read: if belongsToTenant(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /{collection}/{document=**} {
        allow read: if belongsToTenant(tenantId);
        allow write: if belongsToTenant(tenantId);
      }
    }

    match /publicInvites/{inviteId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
